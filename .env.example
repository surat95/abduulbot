# ─────────────────────────────────────────────────────────────
# LINE Messaging API  (จาก LINE Developers Console > channel "อับดุล")
# ─────────────────────────────────────────────────────────────
LINE_CHANNEL_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# จำกัดสิทธิ์: ใส่ LINE userId ของคนที่ดูยอดได้ คั่นด้วย comma
# ปล่อยว่าง = ใครก็ดูได้ (ไม่แนะนำ เพราะเป็นข้อมูลรายได้คลินิก)
# วิธีหา userId: ทักบอทหนึ่งครั้งแล้วดู log บรรทัด "unauthorized user"
ALLOWED_LINE_USER_IDS=

# ─────────────────────────────────────────────────────────────
# Cliniter
# ─────────────────────────────────────────────────────────────
CLINITER_BASE_URL=https://wisedentalclinic.cliniterdental3.com
CLINITER_USERNAME=
CLINITER_PASSWORD=

# path ของหน้า login และหน้ารายงาน (ปกติไม่ต้องแก้)
CLINITER_LOGIN_PATH=/login
CLINITER_REPORT_PATH=/report/income-simple-daily

# ── ตัวเลือกจูน (ใส่เมื่อ auto-detect เดาผิด) ───────────────
# ชื่อ input ของ username/password ถ้าฟอร์มตรวจจับอัตโนมัติไม่เจอ
# CLINITER_USERNAME_FIELD=username
# CLINITER_PASSWORD_FIELD=password
#
# CSS selector ที่ชี้ตรงไปยัง "ยอดรวม" บนหน้ารายงาน
# หาได้จาก `npm run debug:dump` แล้วเปิดไฟล์ HTML ดู
# CLINITER_TOTAL_SELECTOR=
#
# รูปแบบ query string สำหรับเลือกวันที่ ({date} จะถูกแทนด้วยวันที่)
# ถ้าไม่ตั้ง จะเรียกหน้ารายงานเปล่า ๆ (ซึ่งปกติแสดงของ "วันนี้" อยู่แล้ว)
# CLINITER_REPORT_QUERY=date={date}
# CLINITER_DATE_FORMAT=YYYY-MM-DD

# ─────────────────────────────────────────────────────────────
# ทั่วไป
# ─────────────────────────────────────────────────────────────
PORT=8080
TZ=Asia/Bangkok
# cache ยอดกี่วินาที กันยิงถี่ใส่ Cliniter (ค่าเริ่มต้น 60)
INCOME_CACHE_TTL_SECONDS=60
LOG_LEVEL=info
